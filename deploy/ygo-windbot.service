[Unit]
Description=WindBot server (ProjectIgnis/windbot, ServerMode) for ygo-runner's windbot seats
After=network.target

[Service]
ExecStart=/usr/bin/dotnet /srv/ygo/windbot-bin/WindBot.dll ServerMode=true ServerPort=2399 DbPath=/srv/ygo/windbot-bin/cards.cdb
WorkingDirectory=/srv/ygo/windbot-bin
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
